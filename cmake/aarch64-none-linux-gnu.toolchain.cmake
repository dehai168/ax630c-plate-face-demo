# AX630C (AX620E, arm64 glibc) 交叉编译工具链文件
# 推荐工具链: gcc-arm-9.2-2019.12-x86_64-aarch64-none-linux-gnu (与 AX620E SDK V2.0 msp/out/arm64_glibc 匹配)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT TOOLCHAIN_DIR)
  set(TOOLCHAIN_DIR $ENV{TOOLCHAIN_DIR})
endif()
if(TOOLCHAIN_DIR)
  set(_P "${TOOLCHAIN_DIR}/bin/aarch64-none-linux-gnu-")
else()
  set(_P "aarch64-none-linux-gnu-")
endif()
set(CMAKE_C_COMPILER   "${_P}gcc")
set(CMAKE_CXX_COMPILER "${_P}g++")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
set(CMAKE_C_FLAGS_INIT   "-march=armv8-a")
set(CMAKE_CXX_FLAGS_INIT "-march=armv8-a")
